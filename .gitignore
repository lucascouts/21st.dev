# TypeScript
*.tsbuildinfo

# Package manager locks
# bun.lock IS committed on purpose (reproducible installs via --frozen-lockfile).
# This project is Bun-only, so an npm lockfile must never be committed.
package-lock.json

# Epic
.epic/

# Claude Code sub-agent scratch memory.
# Written by agents at runtime, never a project artifact. Note this ignores only
# agent-memory/ — .claude/settings.json and .claude/agents/ stay committable.
.claude/agent-memory/
